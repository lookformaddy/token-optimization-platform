# Token Optimization Platform — environment template
# Copy to .env and adjust. No secrets are needed: the optimizer is fully
# offline and uses synthetic data; there are no model API keys.
TOP_DEFAULT_MAX_TOKENS=8000
TOP_DEFAULT_TARGET_RATIO=0.6
TOP_DEDUP_THRESHOLD=0.85
TOP_SEMANTIC_CACHE_THRESHOLD=0.92
TOP_CACHED_COST_RATIO=0.1
TOP_MIN_QUALITY_PROMOTION=0.85
TOP_MIN_SAVINGS_PROMOTION=0.15
TOP_MAX_TOKENS_PER_REQUEST=8000
TOP_MAX_TOKENS_PER_DAY=1000000
TOP_MAX_COST_USD_PER_DAY=50.00
TOP_INPUT_COST_PER_1K=0.002
TOP_OUTPUT_COST_PER_1K=0.006
TOP_HOST=0.0.0.0
TOP_PORT=8000
